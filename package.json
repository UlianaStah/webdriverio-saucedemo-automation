{
  "name": "webdriverio-saucedemo-automation",
  "version": "1.0.0",
  "description": "E2E UI tests for SauceDemo using WebdriverIO, Mocha and Page Object Model",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "chromedriver": "^156.0.2"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:login": "wdio run ./wdio.conf.js --spec test/specs/login.spec.js",
    "test:inventory": "wdio run ./wdio.conf.js --spec test/specs/inventory.spec.js",
    "test:cart": "wdio run ./wdio.conf.js --spec test/specs/cart.spec.js",
    "test:checkout": "wdio run ./wdio.conf.js --spec test/specs/checkout.spec.js"
  }
}
